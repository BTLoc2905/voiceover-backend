# Copy this file to .env before the first Docker Compose run.
# .env is private and ignored by Git. Use your own local passwords.
FRONTEND_PORT=8088
MYSQL_DATABASE=voicemap_db
MYSQL_USER=voicemap
MYSQL_PASSWORD=replace_with_your_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password

# edge works without a Google API key; both providers still need Internet access.
# google-standard also requires GOOGLE_CLOUD_API_KEY.
TTS_PROVIDER=edge
EDGE_TTS_TIMEOUT_SECONDS=90
GOOGLE_CLOUD_API_KEY=
